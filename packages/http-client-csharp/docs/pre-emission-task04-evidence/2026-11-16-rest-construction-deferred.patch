+            if (kind == "child") { child.Update(keyword: "false", expression: null); }
+            if (kind == "arguments") { (args[0], args[1]) = (args[1], args[0]); }
+            Assert.That(effect!.IsCurrent(new PocWorkBudget(65536)), Is.False);
+            if (kind == "type") { type.Update(name: "Uri"); }
+            if (kind == "child") { child.Update(keyword: "null", expression: null); }
+            if (kind == "arguments") { (args[0], args[1]) = (args[1], args[0]); }
+            Assert.That(effect.IsCurrent(new PocWorkBudget(65536)), Is.False, "Observed withdrawal is terminal.");
