+        [Test]
+        public void Task04RestFiniteConstructionActualFullBodyAndPartialHeadPositive()
+        {
+            CodeFile? expected = null;
+            var nativeProofCalls = 0;
+            var proofCalls = 0;
+            WithRealFoo((owner, prepared) =>
+            {
+                expected = new TypeProviderWriter(((ClientProvider)owner).RestClient) { PreparedFieldTypes = prepared }.Write();
+            }, requestInventory: true, sourceCurrent: () => { nativeProofCalls++; return true; });
+            WithRealFoo((owner, prepared) =>
+            {
+                var target = ((ClientProvider)owner).RestClient;
+                var file = prepared.SourceFiles.Single(f => ReferenceEquals(f.FileOwner, target));
+                var root = file.Roots.Single(r => r.Id.RootRole == "method" && r.Id.RootIndex == 0);
+                var method = (MethodProvider)root.Producer;
+                var body = root.Children.Single(c => ReferenceEquals(c.Producer, method.BodyStatements));
+                foreach (var node in body.DescendantsAndSelf())
+                {
+                    if (node.Producer is Microsoft.TypeSpec.Generator.Expressions.NewInstanceExpression n)
+                    {
+                        TestContext.Out.WriteLine($"REST construction type={n.Type?.Name}; ns={n.Type?.Namespace}; runtime={n.Type?.IsFrameworkType}; args={n.Type?.Arguments.Count}; declaring={n.Type?.DeclaringType}; parameters={n.Parameters.Count}; carrier={n.Parameters.GetType()}; init={n.InitExpression?.GetType().Name ?? "null"}; constructorIntent={n.ConstructorIntent is not null}; providerIntent={n.ConstructorProviderIntent is not null}");
+                    }
+                }
