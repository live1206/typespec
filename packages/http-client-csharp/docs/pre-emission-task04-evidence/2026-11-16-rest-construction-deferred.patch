+        [TestCase(0)]
+        [TestCase(1)]
+        [TestCase(5)]
+        [TestCase(6)]
+        [TestCase(7)]
+        public void Task04RestFiniteConstructionArgumentOccurrencesAndLayout(int count)
+        {
+            var shared = new KeywordExpression("null", null);
+            var arguments = Enumerable.Range(0, count).Select(i => i % 2 == 0 ? shared : new KeywordExpression("true", null)).Cast<ValueExpression>().ToArray();
+            var value = new NewInstanceExpression(new CSharpType(typeof(Uri)), arguments);
+            var effect = PreparedPocNativeCallEffect.TryCapture(value, false, new PocWorkBudget(65536), out var failure);
+            Assert.That(effect, Is.Not.Null, failure);
+            Assert.That(effect!.TryCreateNativeSteps(new PocWorkBudget(65536), out var steps), Is.True);
+            Assert.That(steps.Length, Is.EqualTo(count + 1));
+            Assert.That(steps[0].Producer, Is.SameAs(value));
+            Assert.That(steps[0].End, Is.EqualTo(count + 1));
+            for (var i = 0; i < count; i++)
+            {
+                Assert.That(steps[i + 1].Producer, Is.SameAs(arguments[i]));
+                Assert.That(steps[i + 1].End, Is.EqualTo(i + 2));
+            }
+            using var writer = new CodeWriter();
+            value.Write(writer);
+            var output = writer.ToString(false);
+            Assert.That(output, Does.Contain("new global::System.Uri("));
+            var compact = output.Replace("\r", "").Replace("\n", "").Replace(" ", "");
+            Assert.That(compact, Is.EqualTo("newglobal::System.Uri(" + string.Join(",", arguments.Cast<KeywordExpression>().Select(a => a.Keyword)) + ")"));
+            Assert.That(output.Count(c => c == ','), Is.EqualTo(Math.Max(0, count - 1)));
+            Assert.That(output.Contains('\n'), Is.EqualTo(count >= 6));
+            Assert.That(effect.IsCurrent(new PocWorkBudget(65536)), Is.True);
+        }
