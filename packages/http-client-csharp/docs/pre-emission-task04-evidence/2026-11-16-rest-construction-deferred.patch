+        public void Task04RestFiniteConstructionUnsupportedInputsRefuse(string kind)
+        {
+            CSharpType? type = new CSharpType(typeof(Uri));
+            var unknown = new UnsupportedContextArguments();
+            IReadOnlyList<ValueExpression> args = Array.Empty<ValueExpression>();
+            ObjectInitializerExpression? init = null;
+            if (kind == "null-type") { type = null; }
+            if (kind == "unsafe-name") { type!.Update(name: "Uri\n#error CONSTRUCTION"); }
+            if (kind == "unsafe-namespace") { type!.Update(@namespace: "System\n#error CONSTRUCTION"); }
+            if (kind == "generic") { type = new CSharpType(typeof(List<int>)); }
+            if (kind == "array") { type = new CSharpType(typeof(int[])); }
+            if (kind == "custom-runtime") { type = new CSharpType(new ContextRuntimeTypeProbe(typeof(Uri))); }
+            if (kind.StartsWith("initializer", StringComparison.Ordinal))
+            {
+                var values = new Dictionary<ValueExpression, ValueExpression>();
+                if (kind == "initializer-value") { values.Add(new KeywordExpression("true", null), new KeywordExpression("null", null)); }
+                init = new ObjectInitializerExpression(values, true);
+            }
+            if (kind == "unknown-arguments") { args = unknown; }
+            if (kind == "unsafe-child") { args = new ValueExpression[] { new KeywordExpression("unsafe\n#error CHILD", null) }; }
+            var value = new NewInstanceExpression(type, args, init);
+            var budget = new PocWorkBudget(kind == "tiny-funds" ? 1 : 65536);
+            var effect = PreparedPocNativeCallEffect.TryCapture(value, false, budget, out _);
+            Assert.That(effect, Is.Null, kind);
+            Assert.That(unknown.CountReads + unknown.Reads + unknown.EnumerationReads, Is.Zero, "Do not inspect opaque carriers.");
+        }
